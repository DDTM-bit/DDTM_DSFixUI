<Window x:Class="DDTM_DSFixUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDTM_DSFixUI"
        mc:Ignorable="d"
        Title="DDTM DSFix 3.0 UI SETTINGS" Height="760" Width="850" WindowStartupLocation="CenterScreen" Icon="icofdsfix3.ico">

    <Window.Resources>
        <!-- Dark Souls Theme Styles -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D3D3D3"/>
            <Setter Property="BorderBrush" Value="#FF8C00"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF8C00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D3D3D3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#52290B"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="MaxWidth" Value="400"/>

            <!-- This section forces the text to wrap to a new line -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header / Main Buttons -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Footer / Exit Button -->
        </Grid.RowDefinitions>

        <!-- Top Menu -->
        <Menu Grid.Row="0" Background="#2D2D2D" Foreground="White" Padding="5">
            <MenuItem Header="Load/Save options">
                <MenuItem Header="RELOAD settings from .ini files" Name="MenuLoadDSFix" Click="MenuLoadDSFix_Click" Background="#333333"/>
                <Separator/>
                <MenuItem Header="SAVE settings to a local file" Name="MenuSaveLocal" Click="MenuSaveLocal_Click" Background="#333333"/>
                <MenuItem Header="LOAD settings from a local file" Name="MenuLoadLocal" Click="MenuLoadLocal_Click" Background="#333333"/>
            </MenuItem>
        </Menu>

        <!-- Header Controls -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,92,0">
                <Button Name="BtnApplyOptimal" Content="Apply Optimal Settings" Background="#8B4513" FontWeight="Bold" Click="BtnApplyOptimal_Click"/>
                <TextBlock Name="TxtPcResolution" Text="Display Resolution: Detecting..." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#FF8C00" FontWeight="Bold"/>

            </StackPanel>
            <!-- Save Label -->
            <Label x:Name="labeldsfixsalvat" Content="Saved!" HorizontalAlignment="right" Margin="0,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="52" Foreground="#FF3C7742" FontSize="13" Visibility="Hidden"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnSaveDSFix" Content="SAVE .INI" Background="#FF8C00" Foreground="Black" FontWeight="Bold" FontSize="14" Click="BtnSaveDSFix_Click"/>
                <Button Name="BtnLaunchGame" Content="LAUNCH GAME" Background="#2E8B57" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnLaunchGame_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Settings Tabs -->
        <TabControl Grid.Row="2" Margin="10,10,10,0" Background="#252525" BorderBrush="#FF8C00">

            <!-- 1. GRAPHICS (Most Important) -->
            <TabItem Header="Graphics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Resolution -->
                        <TextBlock Text="Resolution" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,5,0,5"/>
                        <WrapPanel>
                            <Label Content="Internal rendering resolution: "/>
                            <ComboBox Name="cmbRenderResolution" Width="120" Margin="0,0,50,0" ToolTip="The display width/height&#x0a;0x0 means use the same resolution as rendering.&#x0a;(if in doubt, leave at 0)"/>

                            <Label Content="Present res. (for downscaling): "/>
                            <ComboBox Name="cmbPresentResolution" Width="120" ToolTip="The display width/height (0x0 means use the same resolution as rendering)."/>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Framerate -->
                        <TextBlock Text="Framerate" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <CheckBox Name="chkUnlockFPS" Content="Unlock FPS" Foreground="White" Margin="5,5,15,5" IsChecked="True" ToolTip="Enables variable framerate." Unchecked="chkUnlockFPS_Unchecked"/>
                            <Label Content="FPS Limit:"/>
                            <TextBox Name="txtFpsLimit" Width="50" Text="60" Margin="0,0,15,0" ToolTip="Cap framerate. Maximum is 60." TextChanged="TxtFpsLimit_TextChanged"/>
                            <Label Content="FPS Threshold:"/>
                            <TextBox Name="txtFpsThreshold" Width="50" Text="20" ToolTip="Dynamically disables AA if framerate drops below this."/>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Anti Aliasing -->
                        <TextBlock Text="Anti-Aliasing" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Quality:"/>
                            <ComboBox Name="cmbAaQuality" Width="100" Margin="0,0,15,0" ToolTip="Impacts performance and image quality.">
                                <ComboBoxItem Content="0 - Off"/>
                                <ComboBoxItem Content="1 - Low"/>
                                <ComboBoxItem Content="2 - Medium"/>
                                <ComboBoxItem Content="3 - High"/>
                                <ComboBoxItem Content="4 - Ultra" IsSelected="True"/>
                            </ComboBox>
                            <Label Content="Type:"/>
                            <ComboBox Name="cmbAaType" Width="80" ToolTip="Type of Anti-Aliasing to apply.">
                                <ComboBoxItem Content="SMAA" IsSelected="True"/>
                                <ComboBoxItem Content="FXAA"/>
                            </ComboBox>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Ambient Occlusion -->
                        <TextBlock Text="Ambient Occlusion" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Strength:"/>
                            <ComboBox Name="cmbSsaoStrength" Width="100" Margin="0,0,15,0" ToolTip="Strength of SSAO.&#x0a;Options 1-3 have the same performance impact.">
                                <ComboBoxItem Content="0 - Off"/>
                                <ComboBoxItem Content="1 - Low"/>
                                <ComboBoxItem Content="2 - Medium" IsSelected="True"/>
                                <ComboBoxItem Content="3 - High"/>
                            </ComboBox>
                            <Label Content="Scale:"/>
                            <ComboBox Name="cmbSsaoScale" Margin="0,0,20,0" Width="137" ToolTip="1 = high quality (default)&#x0a;2 = lower quality, lower impact on performance&#x0a;3 = lowest quality, lowest impact on performance.">
                                <ComboBoxItem Content="1 - High quality" IsSelected="True"/>
                                <ComboBoxItem Content="2 - Lower quality"/>
                                <ComboBoxItem Content="3 - lowest quality"/>
                            </ComboBox>
                            <Label Content="Type:"/>
                            <ComboBox Name="cmbSsaoType" Width="100" ToolTip="Algorithm used&#x0a;'VSSAO' = Volumetric SSAO (default, only option pre-1.9)&#x0a;'HBAO' = Horizon-Based Ambient Occlusion&#x0a;'SCAO' = VSSAO + HBAO&#x0a;VSSAO and  HBAO types have a slightly different effect. and similar performance&#x0a;SCAO combines both, with a higher performance impact&#x0a;VSSAO2 is generally more accurate, but also requires more performance.">
                                <ComboBoxItem Content="VSSAO"/>
                                <ComboBoxItem Content="HBAO"/>
                                <ComboBoxItem Content="SCAO"/>
                                <ComboBoxItem Content="VSSAO2" IsSelected="True"/>
                            </ComboBox>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Depth of Field (DoF) -->
                        <TextBlock Text="Depth of Field (DoF)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Override Res:"/>
                            <ComboBox Name="cmbDofOverrideResolution" Width="90" Margin="0,0,35,0" ToolTip="Overrides the resolution of the Depth of Field effect.&#x0a;Do not set this to the same value as your vertical rendering resolution!540 = DoF pyramid starts at 960x540&#x0a;810 = DoF pyramid starts at 1440x810&#x0a;1080 = DoF pyramid starts at 1920x1080&#x0a;2160 = DoF pyramid starts at 3840x2160">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="540"/>
                                <ComboBoxItem Content="810" IsSelected="True"/>
                                <ComboBoxItem Content="1080"/>
                                <ComboBoxItem Content="2160"/>
                            </ComboBox>

                            <CheckBox Name="chkDisableDofScaling" Content="Disable DoF Scaling override" Foreground="White" Margin="0,5,45,0" ToolTip="Overrides the scaling of Depth of Field.&#x0a;Keep this enabled." Checked="chkDisableDofScaling_Checked"/>

                            <Label Content="Blur Amount:"/>
                            <ComboBox Name="cmbDofBlurAmount" Width="60" ToolTip="Applies additional blur to the Depth of Field, allowing you to use high DoF resolutions while maintaining the originally intended visual effect.&#x0a;0 (off) at default DoF resolution&#x0a;0 or 1 at 540 DoF resolution&#x0a;1 or 2 above that&#x0a;3 or 4 at 2160 DoF resolution (if you're running a 680+)">
                                <ComboBoxItem Content="0" IsSelected="True"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Filtering -->
                        <TextBlock Text="Filtering" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Filtering Override:"/>
                            <ComboBox Name="cmbFilteringOverride" Width="120" ToolTip="Overrides texture filtering settings. If in doubt, leave this set to 0.">
                                <ComboBoxItem Content="0 - No change" IsSelected="True"/>
                                <ComboBoxItem Content="1 - Bilinear"/>
                                <ComboBoxItem Content="2 - Full AF"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. HUD OPTIONS -->
            <TabItem Header="HUD &amp; UI">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10" >
                        <CheckBox Name="chkEnableHudMod" Content="Enable HUD Modifications" Foreground="White" ToolTip="Master toggle for HUD Modifications" Checked="chkEnableHudMod_Checked" Unchecked="chkEnableHudMod_Unchecked" IsChecked="True"/>

                        <CheckBox Name="chkMinimalHud" Content="Enable Minimal HUD" Foreground="White" Margin="0,5,0,0" ToolTip="Removes weapon icons from the Bottom HUD." Height="25"/>
                        <Separator x:Name="sep1" Height="26" Background="#FF736554" Margin="0,5"/>
                        <Label Width="700" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FFFF5F5F" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" Text="WARNING: Independent HUD scaling is experimental. This will break Boss Health Bars, Dialogue boxes, interaction with sun/moon due to game engine limitations. Change at your own risk." />
                        </Label>
                        <!-- HUD Scaling -->
                        <TextBlock x:Name="txtblockhud1" Text="HUD Scaling (1.0 = Default | 0.75 = 75% | 0.5 = 50%)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,5,0,5"/>
                        <WrapPanel x:Name="wrappanelhud1" Height="72">
                            <Label Content="Health/Stamina: "/>
                            <TextBox Name="txtHudScaleTopLeft" Width="50" Text="1.0" Margin="0,0,15,0" ToolTip="Scales the health bar, stamina bar, and humanity counter."/>
                            <Label Content="Items/Weapons: "/>
                            <TextBox Name="txtHudScaleBottomLeft" Width="50" Text="1.0" Margin="0,0,15,0" ToolTip="Scales the equipped items, weapons, shields, and magic slots."/>
                            <Label Content="Current souls: "/>
                            <TextBox Name="txtHudScaleBottomRight" Width="50" Text="1.0" ToolTip="Scales the current souls count."/>
                        </WrapPanel>
                        <Separator x:Name="sep2" Height="26" Background="#FF736554"/>

                        <!-- HUD Opacity -->
                        <TextBlock x:Name="txtblockhud2" Text="HUD Opacity (0.0 = fully transparent | 1.0 = fully opaque)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel x:Name="wrappanelhud2">
                            <Label Content="Health/Stamina: "/>
                            <TextBox Name="txtHudTopLeftOpacity" Width="50" Text="1.0" Margin="0,0,15,0" ToolTip="Opacity for health bars, stamina bar, humanity counter"/>
                            <Label Content="Items/Weapons: "/>
                            <TextBox Name="txtHudBottomLeftOpacity" Width="50" Text="1.0" Margin="0,0,15,0" ToolTip="Opacity for item indicators and counts."/>
                            <Label Content="Current souls: "/>
                            <TextBox Name="txtHudBottomRightOpacity" Width="50" Text="1.0" ToolTip="Opacity for the soul count."/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. WINDOW & MOUSE -->
            <TabItem Header="Window &amp; Mouse">
                <StackPanel Margin="10">
                    <CheckBox Name="chkBorderless" Content="Borderless Fullscreen" Foreground="White" IsChecked="True" ToolTip="Requires windowed mode in-game!"/>
                    <CheckBox Name="chkDisableCursor" Content="Disable Cursor at Startup" Foreground="White" IsChecked="True" Margin="0,5,0,0" ToolTip="Disable mouse cursor at startup"/>
                    <CheckBox Name="chkCaptureCursor" Content="Capture Cursor (Lock to window)" Foreground="White" Margin="0,5,0,0" ToolTip="capture cursor (do not allow it to leave the window)"/>
                </StackPanel>
            </TabItem>

            <!-- 4. BACKUPS -->
            <TabItem Header="Backups">
                <StackPanel Margin="10">
                    <CheckBox Name="chkEnableBackups" Content="Enable Save Backups" Foreground="White" IsChecked="True" Checked="chkEnableBackups_Checked" Unchecked="chkEnableBackups_Unchecked" />

                    <WrapPanel x:Name="WrapPanelsave1" Margin="0,15,0,0">
                        <Label Content="Backup Interval (sec):"/>
                        <TextBox Name="txtBackupInterval" Width="60" Text="1500" Margin="0,0,15,0" ToolTip="Determines the interval between backups in seconds. Minimum setting is 600."/>
                        <Label Content="Max Backups:"/>
                        <TextBox Name="txtMaxBackups" Width="50" Text="10" ToolTip="Sets the maximum number of backups to keep; older backups will be automatically deleted."/>
                    </WrapPanel>

                    <Label x:Name="labelsavefolder" Content="Custom Save Folder:" Margin="0,15,0,0"/>
                    <TextBox Name="txtCustomSaveFolder" Text="none" Margin="0,0,0,10" Width="514" HorizontalAlignment="Left" ToolTip="Overrides the save folder path. Point directly to the folder containing the .sl2 file. Supports variables like %USERPROFILE%."/>
                    <WrapPanel x:Name="wrappanelsave3">
                        <Button x:Name="BrowseCustomSaveFolder" Content="Browse" Margin="0,0,20,0" Height="30" Width="90" HorizontalAlignment="Left" FontSize="12" Click="BrowseCustomSaveFolder_Click"/>
                        <Label Width="450" Content="Backups are stored in the save folder as '[timestamp]_[original name].bak'" FontStyle="Italic" FontSize="12" Foreground="#FF7F7F7F" HorizontalAlignment="Center" Height="33"/>
                    </WrapPanel>

                </StackPanel>
            </TabItem>

            <!-- 5. MODDING & OVERRIDE -->
            <TabItem Header="Modding &amp; Override">
                <StackPanel Margin="10">
                    <!-- Texture Overrides -->
                    <TextBlock Text="Texture Overrides" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                    <CheckBox Name="chkTextureOverride" Content="Enable Texture Override" Foreground="White" IsChecked="True" ToolTip="Allows texture overrides from dsfix\tex_override folder."/>
                    <CheckBox Name="chkEnableTextureDumping" Content="Enable Texture Dumping" Foreground="White" Margin="0,5,0,0" ToolTip="Set to 1 to dump textures to dsfix\tex_override\[hash].tga.&#x0a;Only needed if creating own overrides."/>
                    <CheckBox Name="chkEnableTexturePrefetch" Content="Enable Texture Prefetch" Foreground="White" Margin="0,5,0,0" ToolTip="Preload override textures into memory at startup.&#x0a;Minor performance boost.&#x0a;On M.2 NVMe SSD this does not matter"/>

                    <!-- Shader Overrides -->
                    <TextBlock Text="Shader Overrides" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                    <CheckBox Name="chkEnableShaderDumping" Content="Enable Shader Dumping" Foreground="White" ToolTip="Dump disassembled pixel and vertex shaders to pixelshader_dump and vertexshader_dump folder"/>
                    <CheckBox Name="chkEnableShaderOverride" Content="Enable Shader Override" Foreground="White" Margin="0,5,0,0" ToolTip="Replace original shaders with custom .asm files from pixelshader_override and vertexshader_override folder."/>
                </StackPanel>
            </TabItem>
            <!-- 6. MISCELLANEOUS OPTIONS -->
            <TabItem Header="Miscellaneous">
                <StackPanel Margin="10">
                    <CheckBox Name="chkSkipIntro" Content="Skip Intro Logos" Foreground="White" IsChecked="True" ToolTip="Disable first if experiencing problems."/>

                    <WrapPanel Margin="0,15,0,0">
                        <Label Content="Override Language:"/>
                        <ComboBox Name="cmbOverrideLanguage" Width="80" ToolTip="Overrides the in-game language. Does not work on Windows XP.">
                            <ComboBoxItem Content="none" IsSelected="True"/>
                            <ComboBoxItem Content="en-GB"/>
                            <ComboBoxItem Content="fr"/>
                            <ComboBoxItem Content="it"/>
                            <ComboBoxItem Content="de"/>
                            <ComboBoxItem Content="es"/>
                            <ComboBoxItem Content="ko"/>
                            <ComboBoxItem Content="zh-tw"/>
                            <ComboBoxItem Content="pl"/>
                            <ComboBoxItem Content="ru"/>
                        </ComboBox>
                    </WrapPanel>

                    <Label Content="Screenshot Directory:" Margin="0,10,0,0"/>
                    <WrapPanel>
                        <TextBox Name="txtScreenshotDir" Text="." Width="355" HorizontalAlignment="Center" ToolTip="Specifies directory where screenshots are saved. Default is '.' value that points to current directory.&#x0a;example: C:\Users\Peter\Pictures" Height="20"/>
                        <Button x:Name="BrowseScreenshotFolder" Content="Browse" Margin="20,0,20,0" Height="30" Width="90" HorizontalAlignment="Left" FontSize="12" Click="BrowseScreenshotFolder_Click"/>
                    </WrapPanel>
                    <Label Content="dinput8.dll Wrapper:" Margin="0,10,0,0"/>
                    <TextBox Name="txtDinput8dllWrapper" Text="none" Width="355" HorizontalAlignment="Left" ToolTip="Chain an additional dinput8.dll wrapper alongside DSfix (e.g., DDTMControllerFix.dll).&#x0a;With 'none' you use the default input from dsfix 2.4"/>

                    <WrapPanel Margin="0,10,0,0">
                        <Label Content="D3D Adapter Override:"/>
                        <TextBox Name="txtD3dAdapterOverride" Width="50" Text="-1" Margin="0,0,15,0" ToolTip="Overrides Direct3D adapter for multiple non-SLI/Crossfire GPUs.&#x0a;N = use adapter N.&#x0a;Default is -1."/>
                        <Label Content="Log Level:"/>
                        <ComboBox Name="cmbLogLevel" Width="60" ToolTip="Higher numbers mean more logging. Only enable for debugging.">
                            <ComboBoxItem Content="0" IsSelected="True"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="11"/>
                        </ComboBox>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
            <!-- 7. KEYS -->
            <TabItem Header="Keys - Toggles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Keybindings (Use VK_ Keys)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" ToolTip="Uncheck a box to disable (comment out) that specific keybind."/>

                        <WrapPanel Margin="0,0,0,5">
                            <CheckBox Name="chkKeyToggleCursorCapture" Content="Toggle Cursor Capture:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleCursorCapture" Width="120" Text="VK_F6" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggleCursorVisibility" Content="Toggle Cursor Visibility:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleCursorVisibility" Width="120" Text="VK_F7"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleBorderless" Content="Toggle Borderless Fullscreen:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleBorderless" Width="120" Text="VK_F8" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyTakeHudlessScreenshot" Content="Take Hudless Screenshot:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="False"/>
                            <TextBox Name="txtKeyTakeHudlessScreenshot" Width="120" Text="VK_NEXT"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleHUD" Content="Toggle HUD:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleHUD" Width="120" Text="VK_RCONTROL" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggleHUDChanges" Content="Toggle HUD Changes:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleHUDChanges" Width="120" Text="VK_RSHIFT"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleSMAA" Content="Toggle SMAA:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleSMAA" Width="120" Text="VK_NumPad1" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggleVSSAO" Content="Toggle VSSAO:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleVSSAO" Width="120" Text="VK_NUMPAD2"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleDofGauss" Content="Toggle DoF Gauss:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleDofGauss" Width="120" Text="VK_NUMPAD3" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggle30FPSLimit" Content="Toggle 30 FPS Limit:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggle30FPSLimit" Width="120" Text="VK_BACK"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5" Height="207">
                            <CheckBox Name="chkKeyReloadSSAO" Content="Reload SSAO Effect:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyReloadSSAO" Width="120" Text="VK_NUMPAD5" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyTogglePaused" Content="Toggle Paused:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="False"/>
                            <TextBox Name="txtKeyTogglePaused" Width="120" Text="VK_F9"/>
                        </WrapPanel>
                        <WrapPanel>

                            <Button x:Name="BtnLoadKeysDefault" Margin="470,0,15,0" Content="Load Keys Default Assignment" Click="BtnLoadKeysDefault_Click"/>

                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <!-- Exit Button -->
        <Button Name="BtnExit" Grid.Row="3" Content="EXIT" HorizontalAlignment="Right" Width="100" Background="#FF2F0404" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,5,10,10" Click="BtnExit_Click"/>
        <Label Content="Settings that differ from the .ini files are marked in blue-violet." HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="3" VerticalAlignment="Center" Foreground="BlueViolet"/>
    </Grid>
</Window>