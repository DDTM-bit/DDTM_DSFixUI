<Window x:Class="DDTM_DSFixUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDTM_DSFixUI"
        mc:Ignorable="d"
        Title="DDTM DSFix 3.0 UI SETTINGS" Height="860" Width="1000" WindowStartupLocation="CenterScreen" Icon="icofdsfix3.ico">

    <Window.Resources>
        <!-- Dark Souls Theme Styles -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D3D3D3"/>
            <Setter Property="BorderBrush" Value="#FF8C00"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF8C00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D3D3D3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#52290B"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="MaxWidth" Value="400"/>

            <!-- This section forces the text to wrap to a new line -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header / Main Buttons -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Footer / Exit Button -->
        </Grid.RowDefinitions>

        <!-- Top Menu -->
        <Menu Grid.Row="0" Background="#2D2D2D" Foreground="White" Padding="5">
            <MenuItem Header="Load/Save options">
                <MenuItem Header="RELOAD settings from .ini files" Name="MenuLoadDSFix" Click="MenuLoadDSFix_Click" Background="#333333"/>
                <Separator/>
                <MenuItem Header="SAVE settings to a local file" Name="MenuSaveLocal" Click="MenuSaveLocal_Click" Background="#333333"/>
                <MenuItem Header="LOAD settings from a local file" Name="MenuLoadLocal" Click="MenuLoadLocal_Click" Background="#333333"/>
            </MenuItem>
        </Menu>

        <!-- Header Controls -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,92,0">
                <Button Name="BtnApplyOptimal" Content="Apply Default Optimal Settings" Background="#8B4513" FontWeight="Bold" Click="BtnApplyOptimal_Click"/>
                <TextBlock Name="TxtPcResolution" Text="Display Resolution: Detecting..." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#FF8C00" FontWeight="Bold"/>

            </StackPanel>
            <!-- Save Label -->
            <Label x:Name="labeldsfixsalvat" Content="Saved!" HorizontalAlignment="right" Margin="0,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="52" Foreground="#FF3C7742" FontSize="13" Visibility="Hidden"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnSaveDSFix" Content="SAVE DSfix" Background="#FF8C00" Foreground="Black" FontWeight="Bold" FontSize="14" Click="BtnSaveDSFix_Click"/>
                <Button Name="BtnLaunchGame" Content="LAUNCH GAME" Background="#2E8B57" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnLaunchGame_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Settings Tabs -->
        <TabControl x:Name="tabMain" SelectionChanged="TabMain_SelectionChanged" Grid.Row="2" Margin="10,10,10,0" Background="#252525" BorderBrush="#FF8C00">

            <!-- 1. GRAPHICS (Most Important) -->
            <TabItem Header="Graphics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Resolution -->
                        <TextBlock Text="Resolution" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,5,0,5"/>
                        <WrapPanel>
                            <Label Content="Internal rendering resolution: "/>
                            <ComboBox Name="cmbRenderResolution" Width="120" Margin="0,0,50,0" ToolTip="The display width/height&#x0a;0x0 means use the same resolution as rendering.&#x0a;(if in doubt, leave at 0)"/>

                            <Label Content="Present res: "/>
                            <ComboBox Name="cmbPresentResolution" Width="120" ToolTip="The display width/height (0x0 means use the same resolution as rendering)."/>
                            <Label Content="For downscaling, set Present res. to your monitor's native resolution and Internal rendering resolution higher." FontSize="12" Foreground="DarkGray"/>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Framerate -->
                        <TextBlock Text="Framerate" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <CheckBox Name="chkUnlockFPS" Content="Unlock FPS" Foreground="White" Margin="5,5,15,5" IsChecked="True" ToolTip="Enables variable framerate." Unchecked="chkUnlockFPS_Unchecked"/>
                            <Label Content="FPS Limit:"/>
                            <TextBox Name="txtFpsLimit" Width="50" Text="60" Margin="0,0,15,0" ToolTip="Cap framerate. Maximum recommended is 144." TextChanged="TxtFpsLimit_TextChanged"/>
                            <Label Content="FPS Threshold:"/>
                            <TextBox Name="txtFpsThreshold" Width="50" Text="20" ToolTip="Dynamically disables AA if framerate drops below this."/>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Anti Aliasing -->
                        <TextBlock Text="Anti-Aliasing" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Quality:"/>
                            <ComboBox Name="cmbAaQuality" Width="100" Margin="0,0,15,0" ToolTip="Impacts performance and image quality.">
                                <ComboBoxItem Content="0 - Off"/>
                                <ComboBoxItem Content="1 - Low"/>
                                <ComboBoxItem Content="2 - Medium"/>
                                <ComboBoxItem Content="3 - High"/>
                                <ComboBoxItem Content="4 - Ultra" IsSelected="True"/>
                            </ComboBox>
                            <Label Content="Type:"/>
                            <ComboBox Name="cmbAaType" Width="80" ToolTip="Type of Anti-Aliasing to apply.">
                                <ComboBoxItem Content="SMAA" IsSelected="True"/>
                                <ComboBoxItem Content="FXAA"/>
                            </ComboBox>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Sharpening -->
                        <TextBlock Text="Sharpening" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <Grid HorizontalAlignment="Left" Width="560" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Sharpen Strength:" VerticalAlignment="Center" ToolTip="for the 3D image after anti-aliasing (the HUD and menus are not sharpened)."/>
                            <Slider Grid.Column="1" Name="sldSharpenStrength" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valSharpenStrength}" ToolTip="for the 3D image after anti-aliasing (the HUD and menus are not sharpened)."/>
                            <TextBlock Grid.Column="2" Name="valSharpenStrength" Text="{Binding Value, ElementName=sldSharpenStrength, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                        </Grid>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Ambient Occlusion -->
                        <TextBlock Text="Ambient Occlusion" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Strength:"/>
                            <ComboBox Name="cmbSsaoStrength" Width="100" Margin="0,0,15,0" ToolTip="Strength of SSAO.&#x0a;Options 1-3 have the same performance impact.">
                                <ComboBoxItem Content="0 - Off"/>
                                <ComboBoxItem Content="1 - Low"/>
                                <ComboBoxItem Content="2 - Medium" IsSelected="True"/>
                                <ComboBoxItem Content="3 - High"/>
                            </ComboBox>
                            <Label Content="Scale:"/>
                            <ComboBox Name="cmbSsaoScale" Margin="0,0,20,0" Width="137" ToolTip="1 = high quality (default)&#x0a;2 = lower quality, lower impact on performance&#x0a;3 = lowest quality, lowest impact on performance.">
                                <ComboBoxItem Content="1 - High quality" IsSelected="True"/>
                                <ComboBoxItem Content="2 - Lower quality"/>
                                <ComboBoxItem Content="3 - lowest quality"/>
                            </ComboBox>
                            <Label Content="Type:"/>
                            <ComboBox Name="cmbSsaoType" Width="100" ToolTip="Algorithm used&#x0a;'VSSAO' = Volumetric SSAO (default, only option pre-1.9)&#x0a;'HBAO' = Horizon-Based Ambient Occlusion&#x0a;'SCAO' = VSSAO + HBAO&#x0a;VSSAO and  HBAO types have a slightly different effect. and similar performance&#x0a;SCAO combines both, with a higher performance impact&#x0a;VSSAO2 is generally more accurate, but also requires more performance.">
                                <ComboBoxItem Content="VSSAO"/>
                                <ComboBoxItem Content="HBAO"/>
                                <ComboBoxItem Content="SCAO"/>
                                <ComboBoxItem Content="VSSAO2" IsSelected="True"/>
                                
                            </ComboBox>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Depth of Field (DoF) -->
                        <TextBlock Text="Depth of Field (DoF)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Override Res:"/>
                            <ComboBox Name="cmbDofOverrideResolution" Width="90" Margin="0,0,35,0" ToolTip="Overrides the resolution of the Depth of Field effect.&#x0a;Do not set this to the same value as your vertical rendering resolution!540 = DoF pyramid starts at 960x540&#x0a;810 = DoF pyramid starts at 1440x810&#x0a;1080 = DoF pyramid starts at 1920x1080&#x0a;2160 = DoF pyramid starts at 3840x2160">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="540"/>
                                <ComboBoxItem Content="810" IsSelected="True"/>
                                <ComboBoxItem Content="1080"/>
                                <ComboBoxItem Content="2160"/>
                            </ComboBox>

                            <CheckBox Name="chkDisableDofScaling" Content="Disable DoF Scaling override" Foreground="White" Margin="0,5,45,0" ToolTip="Overrides the scaling of Depth of Field.&#x0a;Keep this enabled." Checked="chkDisableDofScaling_Checked"/>

                            <Label Content="Blur Amount:"/>
                            <ComboBox Name="cmbDofBlurAmount" Width="60" ToolTip="Applies additional blur to the Depth of Field, allowing you to use high DoF resolutions while maintaining the originally intended visual effect.&#x0a;0 (off) at default DoF resolution&#x0a;0 or 1 at 540 DoF resolution&#x0a;1 or 2 above that&#x0a;3 or 4 at 2160 DoF resolution (if you're running a 680+)">
                                <ComboBoxItem Content="0" IsSelected="True"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </WrapPanel>
                        <Separator Height="6" Background="#FF736554" Margin="0,10,0,0"/>
                        <!-- Filtering -->
                        <TextBlock Text="Filtering" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel>
                            <Label Content="Filtering Override:"/>
                            <ComboBox Name="cmbFilteringOverride" Width="120" ToolTip="Overrides texture filtering settings. If in doubt, leave this set to 0.">
                                <ComboBoxItem Content="0 - No change" IsSelected="True"/>
                                <ComboBoxItem Content="1 - Bilinear"/>
                                <ComboBoxItem Content="2 - Full AF"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. HUD OPTIONS -->
            <TabItem Header="HUD &amp; UI">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10" >
                        <CheckBox Name="chkEnableHudMod" Content="Enable HUD Modifications" Foreground="White" ToolTip="Master toggle for HUD Modifications" Checked="chkEnableHudMod_Checked" Unchecked="chkEnableHudMod_Unchecked" IsChecked="True"/>

                        <Separator x:Name="sep1" Height="26" Background="#FF736554" Margin="0,5"/>
                        <!-- HUD Scaling -->
                        <TextBlock x:Name="txtblockhud1" Text="HUD Scaling (1.0 = Default | 0.75 = 75% | 0.5 = 50%)                            !In-game HUD option must be ON" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,5,0,5"/>
                        <Grid x:Name="wrappanelhud1" HorizontalAlignment="Left" Width="560" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Health/Stamina:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Name="sldHudScaleTopLeft" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valHudScaleTopLeft}" ToolTip="Scales the health bar, stamina bar, and humanity counter."/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Name="valHudScaleTopLeft" Text="{Binding Value, ElementName=sldHudScaleTopLeft, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Items/Weapons:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Name="sldHudScaleBottomLeft" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valHudScaleBottomLeft}" ToolTip="Scales the equipped items, weapons, shields, and magic slots."/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Name="valHudScaleBottomLeft" Text="{Binding Value, ElementName=sldHudScaleBottomLeft, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Current souls:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Name="sldHudScaleBottomRight" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valHudScaleBottomRight}" ToolTip="Scales the current souls count."/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Name="valHudScaleBottomRight" Text="{Binding Value, ElementName=sldHudScaleBottomRight, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Boss Health bar:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1" Name="sldHudScaleBottomCenter" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valHudScaleBottomCenter}" ToolTip="Scales the bottom center HUD elements."/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Name="valHudScaleBottomCenter" Text="{Binding Value, ElementName=sldHudScaleBottomCenter, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                        </Grid>
                        <Separator x:Name="sep2" Height="26" Background="#FF736554"/>

                        <!-- HUD Opacity -->
                        <TextBlock x:Name="txtblockhud2" Text="HUD Opacity (0.0 = fully transparent | 1.0 = fully opaque)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <WrapPanel x:Name="wrappanelhud2">
                            <Label Content="Health/Stamina: "/>
                            <TextBox Name="txtHudTopLeftOpacity" Width="50" Text="1.0" Margin="0,0,15,0" ToolTip="Opacity for health bars, stamina bar, humanity counter"/>
                            <Label Content="Items/Weapons: "/>
                            <TextBox Name="txtHudBottomLeftOpacity" Width="50" Text="1.0" Margin="0,0,15,0" ToolTip="Opacity for item indicators and counts."/>
                            <Label Content="Current souls: "/>
                            <TextBox Name="txtHudBottomRightOpacity" Width="50" Text="1.0" ToolTip="Opacity for the soul count."/>
                        </WrapPanel>
                        <Separator x:Name="sep3" Height="26" Background="#FF736554"/>

                        <!-- Menu and other windows -->
                        <TextBlock x:Name="txtblockhud3" Text="Menu and other windows (1.0 = Default | 0.75 = 75% | 0.5 = 50%)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                        <Grid x:Name="wrappanelhud3" HorizontalAlignment="Left" Width="560" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Menu/Inventory:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Name="sldMenuScale" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valMenuScale}" ToolTip="Top right quick menu and the inventory/status windows."/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Name="valMenuScale" Text="{Binding Value, ElementName=sldMenuScale, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Bonfire/NPC list:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Name="sldListWindowScale" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valListWindowScale}" ToolTip="Bonfire menu and the other list windows on the left side of the screen."/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Name="valListWindowScale" Text="{Binding Value, ElementName=sldListWindowScale, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Interaction prompts:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Name="sldPromptScale" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valPromptScale}" ToolTip="Interaction prompts, Yes/No questions."/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Name="valPromptScale" Text="{Binding Value, ElementName=sldPromptScale, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Subtitles:" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1" Name="sldSubtitleScale" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,4" Tag="{Binding ElementName=valSubtitleScale}" ToolTip="NPC dialogue subtitles."/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Name="valSubtitleScale" Text="{Binding Value, ElementName=sldSubtitleScale, StringFormat=F2, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. WINDOW & MOUSE -->
            <TabItem Header="Window &amp; Mouse">
                <StackPanel Margin="10">
                    <CheckBox Name="chkBorderless" Content="Borderless Fullscreen  (check this only for the game's Screen Mode set to Windowed)" Foreground="White" IsChecked="True" ToolTip="Requires windowed mode in-game!"/>
                    <CheckBox Name="chkDisableCursor" Content="Disable Cursor at Startup" Foreground="White" IsChecked="True" Margin="0,5,0,0" ToolTip="Disable mouse cursor at startup"/>
                    <CheckBox Name="chkCaptureCursor" Content="Capture Cursor (Lock to window)" Foreground="White" Margin="0,5,0,0" ToolTip="capture cursor (do not allow it to leave the window)"/>
                    <Separator Height="25" Background="#FF736554" Margin="0,15,0,0"/>
                    <!-- In-game fullscreen only -->
                    <TextBlock Text="This only applies to the in-game fullscreen setting:" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5" Height="42"/>
                    <WrapPanel>
                        <Label Content="VSync:" Width="62"/>
                        <ComboBox Name="cmbEnableVsync" Width="170" Margin="0,0,25,0" ToolTip="VSync in the game's fullscreen mode.">
                            <ComboBoxItem Content="game's choice (default)" IsSelected="True"/>
                            <ComboBoxItem Content="On"/>
                            <ComboBoxItem Content="Off"/>
                        </ComboBox>
                        <Label Content="Refresh Rate Hz:"/>
                        <TextBox Name="txtFullscreenHz" Width="60" Text="0" VerticalAlignment="Center" ToolTip="Refresh rate in the game's fullscreen mode: 0 = leave the game's choice (default) or a value such as 120, 144, 165, 180. DSfix checks it against the rates your monitor supports and uses the highest one that is not above this value."/>
                    </WrapPanel>
                    <!-- Info: G-Sync / FreeSync (calm info card, muted colours) -->
                    <Border Background="#2B2E31" BorderBrush="#4D5A63" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,25,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- small "i" badge -->
                            <Border Width="22" Height="22" CornerRadius="11" Background="#4D6B7A" VerticalAlignment="Top" Margin="0,1,12,0">
                                <TextBlock Text="i" Foreground="#E8EEF2" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="G-Sync / FreeSync" Foreground="#E0C08A" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#C8CCD0" LineHeight="20" Text="Dark Souls can only use G-Sync / FreeSync in its own fullscreen mode (not in a window or borderless)."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#C8CCD0" LineHeight="20" Margin="0,8,0,0">
                                    <Run Text="With G-Sync / FreeSync:" FontWeight="SemiBold" Foreground="#A8CFA0"/>
                                    <Run Text="untick Borderless Fullscreen, set the game to fullscreen, VSync on, Refresh Rate = monitor max, FPS limit a few below it."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="#C8CCD0" LineHeight="20" Margin="0,6,0,0">
                                    <Run Text="Without G-Sync / FreeSync:" FontWeight="SemiBold" Foreground="#9CBFD8"/>
                                    <Run Text="Fullscreen or Borderless both are fine but unlike G-Sync/FreeSync, you must put an FPS limit that divides your refresh rate evenly (e.g. 60 on 60/120/180/240 Hz)."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 4. BACKUPS -->
            <TabItem Header="Backups">
                <StackPanel Margin="10">
                    <CheckBox Name="chkEnableBackups" Content="Enable Save Backups" Foreground="White" IsChecked="True" Checked="chkEnableBackups_Checked" Unchecked="chkEnableBackups_Unchecked" />

                    <WrapPanel x:Name="WrapPanelsave1" Margin="0,15,0,0">
                        <Label Content="Backup Interval (sec):"/>
                        <TextBox Name="txtBackupInterval" Width="60" Text="1500" Margin="0,0,15,0" ToolTip="Determines the interval between backups in seconds. Minimum setting is 600."/>
                        <Label Content="Max Backups:"/>
                        <TextBox Name="txtMaxBackups" Width="50" Text="10" ToolTip="Sets the maximum number of backups to keep; older backups will be automatically deleted."/>
                    </WrapPanel>

                    <Label x:Name="labelsavefolder" Content="Custom Save Folder:" Margin="0,15,0,0"/>
                    <TextBox Name="txtCustomSaveFolder" Text="none" Margin="0,0,0,10" Width="514" HorizontalAlignment="Left" ToolTip="Overrides the save folder path. Point directly to the folder containing the .sl2 file. Supports variables like %USERPROFILE%."/>
                    <WrapPanel x:Name="wrappanelsave3">
                        <Button x:Name="BrowseCustomSaveFolder" Content="Browse" Margin="0,0,20,0" Height="30" Width="90" HorizontalAlignment="Left" FontSize="12" Click="BrowseCustomSaveFolder_Click"/>
                        <Label Width="450" Content="Backups are stored in the save folder as '[timestamp]_[original name].bak'" FontStyle="Italic" FontSize="12" Foreground="#FF7F7F7F" HorizontalAlignment="Center" Height="33"/>
                    </WrapPanel>

                </StackPanel>
            </TabItem>

            <!-- 5. MODDING & OVERRIDE -->
            <TabItem Header="Modding &amp; Override">
                <StackPanel Margin="10">
                    <!-- Texture Overrides -->
                    <TextBlock Text="Texture Overrides" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                    <CheckBox Name="chkTextureOverride" Content="Enable Texture Override" Foreground="White" IsChecked="True" ToolTip="Allows texture overrides from dsfix\tex_override folder."/>
                    <CheckBox Name="chkEnableTextureDumping" Content="Enable Texture Dumping" Foreground="White" Margin="0,5,0,0" ToolTip="Set to 1 to dump textures to dsfix\tex_override\[hash].tga.&#x0a;Only needed if creating own overrides."/>
                    <CheckBox Name="chkEnableTexturePrefetch" Content="Enable Texture Prefetch" Foreground="White" Margin="0,5,0,0" ToolTip="Preload override textures into memory at startup.&#x0a;Minor performance boost.&#x0a;On M.2 NVMe SSD this does not matter"/>

                    <!-- Shader Overrides -->
                    <TextBlock Text="Shader Overrides" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                    <CheckBox Name="chkEnableShaderDumping" Content="Enable Shader Dumping" Foreground="White" ToolTip="Dump disassembled pixel and vertex shaders to pixelshader_dump and vertexshader_dump folder"/>
                    <CheckBox Name="chkEnableShaderOverride" Content="Enable Shader Override" Foreground="White" Margin="0,5,0,0" ToolTip="Replace original shaders with custom .asm files from pixelshader_override and vertexshader_override folder."/>
                </StackPanel>
            </TabItem>
            <!-- 6. MISCELLANEOUS OPTIONS -->
            <TabItem Header="Miscellaneous">
                <StackPanel Margin="10">
                    <CheckBox Name="chkSkipIntro" Content="Skip Intro Logos" Foreground="White" IsChecked="True" ToolTip="Disable first if experiencing problems."/>

                    <WrapPanel Margin="0,15,0,0">
                        <Label Content="Override Language:"/>
                        <ComboBox Name="cmbOverrideLanguage" Width="80" ToolTip="Overrides the in-game language. Does not work on Windows XP.">
                            <ComboBoxItem Content="none" IsSelected="True"/>
                            <ComboBoxItem Content="en-GB"/>
                            <ComboBoxItem Content="fr"/>
                            <ComboBoxItem Content="it"/>
                            <ComboBoxItem Content="de"/>
                            <ComboBoxItem Content="es"/>
                            <ComboBoxItem Content="ko"/>
                            <ComboBoxItem Content="zh-tw"/>
                            <ComboBoxItem Content="pl"/>
                            <ComboBoxItem Content="ru"/>
                        </ComboBox>
                    </WrapPanel>

                    <Label Content="Screenshot Directory:" Margin="0,10,0,0"/>
                    <WrapPanel>
                        <TextBox Name="txtScreenshotDir" Text="." Width="355" HorizontalAlignment="Center" ToolTip="Specifies directory where screenshots are saved. Default is '.' value that points to current directory.&#x0a;example: C:\Users\Peter\Pictures" Height="29"/>
                        <Button x:Name="BrowseScreenshotFolder" Content="Browse" Margin="20,0,20,0" Height="30" Width="90" HorizontalAlignment="Left" FontSize="12" Click="BrowseScreenshotFolder_Click"/>
                    </WrapPanel>
                    <Label Content="dinput8.dll Wrapper:" Margin="0,10,0,0"/>
                    <WrapPanel>
                        <TextBox Name="txtDinput8dllWrapper" Text="none" Width="355" HorizontalAlignment="Center" Height="28" ToolTip="Chain an additional dinput8.dll wrapper alongside DSfix (e.g., DDTMControllerFix.dll).&#x0a;With 'none' you use the default input from dsfix 2.4" FontSize="15"/>
                        <Button x:Name="BrowseDinput8Wrapper" Content="Browse" Margin="20,0,20,0" Height="30" Width="90" HorizontalAlignment="Left" FontSize="12" Click="BrowseDinput8Wrapper_Click" ToolTip="Select the wrapper .dll file. Type 'none' in the box to disable it."/>
                    </WrapPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <Label Content="D3D Adapter Override:"/>
                        <TextBox Name="txtD3dAdapterOverride" Width="50" Text="-1" Margin="0,0,15,0" ToolTip="Overrides Direct3D adapter for multiple non-SLI/Crossfire GPUs.&#x0a;N = use adapter N.&#x0a;Default is -1."/>
                        <Label Content="Log Level:"/>
                        <ComboBox Name="cmbLogLevel" Width="60" ToolTip="Higher numbers mean more logging. Only enable for debugging.">
                            <ComboBoxItem Content="0" IsSelected="True"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="11"/>
                        </ComboBox>
                    </WrapPanel>
                    <Separator Height="6" Background="#FF736554" Margin="0,15,0,0"/>
                    <!-- Controller Button Prompt Swap -->
                    <TextBlock Text="Controller Button Prompt Swap (Only the Icons In-game)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                    <CheckBox Name="chkSwapConfirmIcons" Content="Swap confirm icons (cross / circle - A / B)" Foreground="White" Margin="0,5,0,0" ToolTip="In-game swap cross and circle (A and B) button icons."/>
                    <CheckBox Name="chkSwapXYIcons" Content="Swap X / Y icons (square / triangle - X / Y)" Foreground="White" Margin="0,5,0,0" ToolTip="In-game swap square and triangle (X and Y) button icons." Height="35"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Label Content="DSfix 3.0 In-Game Controller icons:" Width="240"/>
                        <ComboBox Name="cmbControllerIcons" Width="120" ToolTip="Controller button icons (button prompts and quick menu), built into DSfix3">
                            <ComboBoxItem Content="off"/>
                            <ComboBoxItem Content="auto"/>
                            <ComboBoxItem Content="xbox"/>
                            <ComboBoxItem Content="playstation"/>
                            <ComboBoxItem Content="switch"/>
                        </ComboBox>
                    </WrapPanel>
                    <Separator Height="6" Background="#FF736554" Margin="0,15,0,0"/>
                    <!-- Items & HUD -->
                    <TextBlock Text="QoL: Items &amp; HUD" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,15,0,5"/>
                    <CheckBox Name="chkDisableItemAutoEquip" Content="Disable item auto-equip (Estus unchanged)" Foreground="White" Margin="0,5,0,0" ToolTip="Consumables you pick up are no longer put into your quick item slots automatically (Estus unchanged)."/>
                    <CheckBox Name="chkDurabilityBars" Content="Show weapon durability bars (Dark Souls III Style)" Foreground="White" Margin="0,5,0,0" ToolTip="Thin bar under each weapon slot showing durability left (bottom-left HUD)."/>
                    
                </StackPanel>
            </TabItem>
            <!-- 7. KEYS -->
            <TabItem Header="Keys - Toggles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Keybindings (Use VK_ Keys)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" ToolTip="Uncheck a box to disable (comment out) that specific keybind."/>

                        <WrapPanel Margin="0,0,0,5">
                            <CheckBox Name="chkKeyToggleCursorCapture" Content="Toggle Cursor Capture:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleCursorCapture" Width="120" Text="VK_F6" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggleCursorVisibility" Content="Toggle Cursor Visibility:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleCursorVisibility" Width="120" Text="VK_F7"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleBorderless" Content="Toggle Borderless Fullscreen:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleBorderless" Width="120" Text="VK_F8" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyTakeHudlessScreenshot" Content="Take Hudless Screenshot:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="False"/>
                            <TextBox Name="txtKeyTakeHudlessScreenshot" Width="120" Text="VK_NEXT"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleHUD" Content="Toggle HUD:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleHUD" Width="120" Text="VK_RCONTROL" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggleHUDChanges" Content="Toggle HUD Changes:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleHUDChanges" Width="120" Text="VK_RSHIFT"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleSMAA" Content="Toggle SMAA:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleSMAA" Width="120" Text="VK_NumPad1" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggleVSSAO" Content="Toggle VSSAO:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleVSSAO" Width="120" Text="VK_NUMPAD2"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyToggleDofGauss" Content="Toggle DoF Gauss:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggleDofGauss" Width="120" Text="VK_NUMPAD3" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyToggle30FPSLimit" Content="Toggle 30 FPS Limit:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyToggle30FPSLimit" Width="120" Text="VK_BACK"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5">
                            <CheckBox Name="chkKeyReloadSSAO" Content="Reload SSAO Effect:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True"/>
                            <TextBox Name="txtKeyReloadSSAO" Width="120" Text="VK_NUMPAD5" Margin="0,0,15,0"/>

                            <CheckBox Name="chkKeyTogglePaused" Content="Toggle Paused:" Width="190" Foreground="White" VerticalAlignment="Center" IsChecked="False"/>
                            <TextBox Name="txtKeyTogglePaused" Width="120" Text="VK_F9"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,5,0,5" Height="172">
                            <CheckBox Name="chkKeyToggleSharpen" Content="Toggle Sharpen:" Width="200" Foreground="White" VerticalAlignment="Center" IsChecked="True" ToolTip="Turns the sharpening effect on/off in game (toggleSharpen in DSfixKeys.ini)."/>
                            <TextBox Name="txtKeyToggleSharpen" Width="120" Text="VK_F4" Margin="0,0,15,0"/>
                        </WrapPanel>
                        <WrapPanel>

                            <Button x:Name="BtnLoadKeysDefault" Margin="470,0,15,0" Content="Load Keys Default Assignment" Click="BtnLoadKeysDefault_Click"/>

                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- 8. DDTM CONTROLLER -->
            <TabItem Header="DDTM Controller" x:Name="tabController">
                <Grid>
                    <Grid x:Name="gridController">
                        <Grid.Resources>
                            <Style x:Key="MapCard" TargetType="Border">
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="Padding" Value="7"/>
                                <Setter Property="Background" Value="#2D2D2D"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Width" Value="128"/>
                            </Style>
                            <Style x:Key="MapTitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="MapSub" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Foreground" Value="#A8A8A8"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                            <Style x:Key="MapCombo" TargetType="ComboBox">
                                <Setter Property="Width" Value="100"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                            <Style x:Key="PresetCard" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="card" Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="2" CornerRadius="6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="dot" Width="16" Height="16" Stroke="#FF8C00" StrokeThickness="2" Fill="Transparent" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                    <ContentPresenter Grid.Column="1"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="#FFB347"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="#FF8C00"/>
                                                    <Setter TargetName="card" Property="Background" Value="#3A2A18"/>
                                                    <Setter TargetName="dot" Property="Fill" Value="#FF8C00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TabControl x:Name="tabControllerInner" Grid.Row="0" Margin="5" Background="#252525" BorderBrush="#FF8C00">
                            <TabItem Header="BUTTON MAPPING">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Each card is a game input. Choose the real controller button for it from the list." Foreground="#D3D3D3" TextWrapping="Wrap" Margin="4,0,4,6"/>
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                            <Grid Width="940">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border Style="{StaticResource MapCard}" Width="128" BorderBrush="#9AA5B1" ToolTip="Game input 'LT'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="LT" Style="{StaticResource MapTitle}" Foreground="#9AA5B1"/>
                                                            <TextBlock Text="Left trigger" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_LT" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource MapCard}" Width="128" BorderBrush="#9AA5B1" ToolTip="Game input 'LB'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="LB" Style="{StaticResource MapTitle}" Foreground="#9AA5B1"/>
                                                            <TextBlock Text="Left bumper" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_LB" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border Style="{StaticResource MapCard}" Width="128" BorderBrush="#9AA5B1" ToolTip="Game input 'RB'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="RB" Style="{StaticResource MapTitle}" Foreground="#9AA5B1"/>
                                                            <TextBlock Text="Right bumper" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_RB" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource MapCard}" Width="128" BorderBrush="#9AA5B1" ToolTip="Game input 'RT'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="RT" Style="{StaticResource MapTitle}" Foreground="#9AA5B1"/>
                                                            <TextBlock Text="Right trigger" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_RT" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MapCard}" Width="112" BorderBrush="#D8D8D8" ToolTip="Game input 'DPAD_UP'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="D-Pad &#9650;" Style="{StaticResource MapTitle}" Foreground="#D8D8D8"/>
                                                            <TextBlock Text="Direction pad" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_DPAD_UP" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MapCard}" Width="112" BorderBrush="#D8D8D8" ToolTip="Game input 'DPAD_LEFT'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="D-Pad &#9664;" Style="{StaticResource MapTitle}" Foreground="#D8D8D8"/>
                                                            <TextBlock Text="Direction pad" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_DPAD_LEFT" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MapCard}" Width="112" BorderBrush="#D8D8D8" ToolTip="Game input 'DPAD_RIGHT'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="D-Pad &#9654;" Style="{StaticResource MapTitle}" Foreground="#D8D8D8"/>
                                                            <TextBlock Text="Direction pad" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_DPAD_RIGHT" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MapCard}" Width="112" BorderBrush="#D8D8D8" ToolTip="Game input 'DPAD_DOWN'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="D-Pad &#9660;" Style="{StaticResource MapTitle}" Foreground="#D8D8D8"/>
                                                            <TextBlock Text="Direction pad" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_DPAD_DOWN" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Border Style="{StaticResource MapCard}" Width="176" BorderBrush="#C9B037" ToolTip="Game input 'BACK'.&#x0a;You can map TWO different buttons to it (e.g. TOUCHPAD and SHARE).&#x0a;Set the 2nd to NONE to use just one.">
                                                        <StackPanel>
                                                            <TextBlock Text="BACK" Style="{StaticResource MapTitle}" Foreground="#C9B037"/>
                                                            <TextBlock Text="Back / Select - up to 2 buttons" Style="{StaticResource MapSub}"/>
                                                            <TextBlock Text="1st button" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_BACK" Style="{StaticResource MapCombo}" Width="150"/>
                                                            <TextBlock Text="2nd button (optional)" Style="{StaticResource MapSub}" Margin="0,4,0,0"/>
                                                            <ComboBox x:Name="cmbMap_BACK2" Style="{StaticResource MapCombo}" Width="150"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource MapCard}" Width="176" BorderBrush="#C9B037" ToolTip="Game input 'START'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="START" Style="{StaticResource MapTitle}" Foreground="#C9B037"/>
                                                            <TextBlock Text="Start / menu" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_START" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MapCard}" Width="112" BorderBrush="#E6C229" ToolTip="Game input 'Y'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="Y" Style="{StaticResource MapTitle}" Foreground="#E6C229"/>
                                                            <TextBlock Text="Xbox Y button" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_Y" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MapCard}" Width="112" BorderBrush="#4A90D9" ToolTip="Game input 'X'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                        <StackPanel>
                                                            <TextBlock Text="X" Style="{StaticResource MapTitle}" Foreground="#4A90D9"/>
                                                            <TextBlock Text="Xbox X button" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_X" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MapCard}" Width="112" BorderBrush="#E0524D" ToolTip="Game input 'B'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.&#x0a;Default game use: roll / sprint / backstep / cancel.&#x0a;For the Japanese layout set A = CIRCLE and B = CROSS (both!).">
                                                        <StackPanel>
                                                            <TextBlock Text="B" Style="{StaticResource MapTitle}" Foreground="#E0524D"/>
                                                            <TextBlock Text="Roll / sprint / cancel" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_B" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MapCard}" Width="112" BorderBrush="#3CB371" ToolTip="Game input 'A'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.&#x0a;Default game use: confirm / interact.&#x0a;For the Japanese layout set A = CIRCLE and B = CROSS (both!).">
                                                        <StackPanel>
                                                            <TextBlock Text="A" Style="{StaticResource MapTitle}" Foreground="#3CB371"/>
                                                            <TextBlock Text="Confirm / interact" Style="{StaticResource MapSub}"/>
                                                            <ComboBox x:Name="cmbMap_A" Style="{StaticResource MapCombo}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Border HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" Style="{StaticResource MapCard}" Width="128" BorderBrush="#7FA6D6" ToolTip="Game input 'LS'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                    <StackPanel>
                                                        <TextBlock Text="LS" Style="{StaticResource MapTitle}" Foreground="#7FA6D6"/>
                                                        <TextBlock Text="Left stick click" Style="{StaticResource MapSub}"/>
                                                        <ComboBox x:Name="cmbMap_LS" Style="{StaticResource MapCombo}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border HorizontalAlignment="Center" Grid.Row="2" Grid.Column="2" Style="{StaticResource MapCard}" Width="128" BorderBrush="#7FA6D6" ToolTip="Game input 'RS'.&#x0a;Pick the real controller button that should trigger it.&#x0a;NONE disables this input.">
                                                    <StackPanel>
                                                        <TextBlock Text="RS" Style="{StaticResource MapTitle}" Foreground="#7FA6D6"/>
                                                        <TextBlock Text="Right stick click" Style="{StaticResource MapSub}"/>
                                                        <ComboBox x:Name="cmbMap_RS" Style="{StaticResource MapCombo}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Viewbox>
                                        <Border Background="#2A2A2A" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,12,4,4">
                                            <StackPanel>
                                                <TextBlock Text="Japanese PS3 layout" Foreground="#FF8C00" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock TextWrapping="Wrap" Foreground="#D3D3D3" Margin="0,3,0,6" Text="This swaps A (CROSS) with B (CIRCLE), as in the Japanese PS3 release."/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Use Japanese layout (A = CIRCLE, B = CROSS)" Click="BtnJapaneseLayout_Click" Margin="0,0,8,0"/>
                                                    <Button Content="Use standard layout (A = CROSS, B = CIRCLE)" Click="BtnStandardLayout_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="PRESETS">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="1. PRESET - START HERE" Foreground="#FF8C00" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#E0E0E0" Margin="0,6,0,0" Text="A preset sets up the macros AND the behaviour switches that go with them, in one go. Presets never change your button mapping, so your controller layout (including the Japanese layout) is always kept."/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#E0E0E0" Margin="0,6,0,0" Text="A preset overrides the macro lines (Macros tab) and the behaviour settings (Advanced Settings tab). To build your own setup instead, leave this on NONE."/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#9ACD32" FontWeight="SemiBold" Margin="0,6,0,12" Text="Quick start: pick ONE preset below and you are done. Everything else is optional fine tuning."/>
                                        <RadioButton x:Name="rbPreset_NONE" GroupName="DdtmPreset" Tag="NONE" Style="{StaticResource PresetCard}" ToolTip="Preset = NONE&#x0a;Only one preset can be active.">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="NONE" Foreground="#FF8C00" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="   Vanilla controls, no macros" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Vanilla controls, no macros. You still get the controller support, deadzones, sensitivity and rumble fixes. Choose this to build your own setup with the Macros and Advanced Settings tabs." Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="rbPreset_DS3_JUMP" GroupName="DdtmPreset" Tag="DS3_JUMP" Style="{StaticResource PresetCard}" ToolTip="Preset = DS3_JUMP&#x0a;Only one preset can be active.">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="DS3_JUMP" Foreground="#FF8C00" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="   Jump on its own button, like Dark Souls 3" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="L3 = jump" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="Your roll button can no longer jump by accident, so the only jumps you get are the ones you pressed L3 for. Rolling, sprinting, backstepping and Cancel all behave exactly as normal. The simplest preset, and the one that changes the least." Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="rbPreset_MORTAL_SHELL" GroupName="DdtmPreset" Tag="MORTAL_SHELL" Style="{StaticResource PresetCard}" ToolTip="Preset = MORTAL_SHELL&#x0a;Only one preset can be active.">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="MORTAL_SHELL" Foreground="#FF8C00" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="   Sprint moved onto CROSS" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="CROSS = hold to sprint" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="L3 = toggle auto-run" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="CROSS + R1 = kick" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="CROSS + R2 = leaping attack" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="Adds a second sprint button on CROSS, so you can run without touching the roll button. CIRCLE is left exactly as the game made it and still rolls, sprints and jumps as normal. CROSS keeps its normal job too, so menus work." Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="rbPreset_ELDEN_RING" GroupName="DdtmPreset" Tag="ELDEN_RING" Style="{StaticResource PresetCard}" ToolTip="Preset = ELDEN_RING&#x0a;Only one preset can be active.">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ELDEN_RING" Foreground="#FF8C00" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="   Jump on CROSS, like Elden Ring" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="CROSS = jump" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="L3 = toggle auto-run" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="CROSS + R1 = kick" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="CROSS + R2 = leaping attack" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="Your roll button can no longer jump by accident. CROSS keeps its normal job, so menus still work: standing still it just interacts, and it only jumps while you are holding the stick in a direction. Warning: CROSS is also Interact, so a jump next to a lever or item can set that thing off." Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="rbPreset_RUN_AND_ATTACK" GroupName="DdtmPreset" Tag="RUN_AND_ATTACK" Style="{StaticResource PresetCard}" ToolTip="Preset = RUN_AND_ATTACK&#x0a;Only one preset can be active.">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="RUN_AND_ATTACK" Foreground="#FF8C00" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="   Vanilla movement, better attacks" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="L3 = toggle auto-run" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="CIRCLE + R1 = kick" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="CIRCLE + R2 = leaping attack" Foreground="#9ACD32" FontFamily="Consolas" FontSize="13" Margin="14,2,0,0"/>
                                                <TextBlock Text="Rolling, sprinting and jumping are left exactly as the game made them. Adds only the auto-run for long runbacks and reliable kicks and leaping attacks, with no stick flick needed. The safest choice if you do not want your movement touched at all." Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="MACROS">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <Border x:Name="txtMacroBanner" Visibility="Collapsed" Background="#4A1F1F" BorderBrush="#FF5F5F" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                            <TextBlock Foreground="#FFB0B0" TextWrapping="Wrap" Text="A preset is selected (see the PRESETS tab), so it overrides everything on this tab. Choose NONE on the PRESETS tab to edit macros yourself."/>
                                        </Border>
                                        <StackPanel x:Name="panelMacros">
                                            <TextBlock Text="MACROS (only used when Preset = NONE)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,14,0,2"/>
                                            <TextBlock Text="Assign one button, or a combination of up to 3 buttons that must be pressed together (e.g. R1 + L3). Leave all three on NONE to disable a macro." Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <Border Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,3" ToolTip="Kick (KICK)&#x0a;Instant kick.&#x0a;Button 1 alone = single button. Add Button 2 / 3 for a combination.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Kick" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Instant kick." Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="cmbMacro_KICK_1" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_KICK_2" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_KICK_3" Width="112" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,3" ToolTip="Leap attack (LEAP_ATTACK)&#x0a;Instant jumping heavy attack.&#x0a;Button 1 alone = single button. Add Button 2 / 3 for a combination.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Leap attack" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Instant jumping heavy attack." Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="cmbMacro_LEAP_ATTACK_1" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_LEAP_ATTACK_2" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_LEAP_ATTACK_3" Width="112" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,3" ToolTip="Auto-run (AUTO_RUN)&#x0a;Toggle auto-sprint. Push the stick and you run on your own. Switches off when you stop, attack or open a menu.&#x0a;Button 1 alone = single button. Add Button 2 / 3 for a combination.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Auto-run" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Toggle auto-sprint. Push the stick and you run on your own. Switches off when you stop, attack or open a menu." Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="cmbMacro_AUTO_RUN_1" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_AUTO_RUN_2" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_AUTO_RUN_3" Width="112" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,3" ToolTip="Dash / sprint only (DASH_SPRINT_ONLY)&#x0a;Hold to sprint. Taps can never roll, and pressing it again right after cannot jump.&#x0a;Button 1 alone = single button. Add Button 2 / 3 for a combination.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Dash / sprint only" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Hold to sprint. Taps can never roll, and pressing it again right after cannot jump." Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="cmbMacro_DASH_SPRINT_ONLY_1" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_DASH_SPRINT_ONLY_2" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_DASH_SPRINT_ONLY_3" Width="112" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,3" ToolTip="Roll only (ROLL_ONLY)&#x0a;Always rolls, never sprints, however long you hold it. Standing still it backsteps, as the game normally does.&#x0a;Button 1 alone = single button. Add Button 2 / 3 for a combination.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Roll only" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Always rolls, never sprints, however long you hold it. Standing still it backsteps, as the game normally does." Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="cmbMacro_ROLL_ONLY_1" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_ROLL_ONLY_2" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_ROLL_ONLY_3" Width="112" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#2D2D2D" BorderBrush="#5A4A3A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,3" ToolTip="Jump only (JUMP_ONLY)&#x0a;Jump. You must be holding the stick in a direction; it does nothing standing still, because the game has no standing jump. Instant while already sprinting, with a short wind-up from a walk.&#x0a;Button 1 alone = single button. Add Button 2 / 3 for a combination.">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Jump only" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Jump. You must be holding the stick in a direction; it does nothing standing still, because the game has no standing jump. Instant while already sprinting, with a short wind-up from a walk." Foreground="#B8B8B8" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="cmbMacro_JUMP_ONLY_1" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_JUMP_ONLY_2" Width="112" Height="26"/>
                                                        <TextBlock Text="+" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <ComboBox x:Name="cmbMacro_JUMP_ONLY_3" Width="112" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Separator Height="6" Background="#FF736554" Margin="0,8,0,0"/>
                                            <TextBlock Text="MACRO BEHAVIOUR" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,14,0,2"/>
                                            <CheckBox x:Name="chk_AutoRun_CancelOnStop" Content="Auto-run: cancel when the stick is released" Foreground="White" Margin="0,4,0,0" ToolTip="AutoRun_CancelOnStop&#x0a;ON: auto-sprint switches off once you let the stick go, so moving again walks. Press the button again to turn it back on.&#x0a;OFF: it stays on until you press the button, attack, or open a menu."/>
                                            <TextBlock Text="ON: auto-sprint switches off once you let the stick go, so moving again walks. OFF: it stays on until you press the button, attack, or open a menu." Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="chk_SuppressMacroButtons" Content="Suppress the normal input of single-button macro buttons" Foreground="White" Margin="0,4,0,0" ToolTip="SuppressMacroButtons&#x0a;ON: a button used by a single-button macro stops sending its normal input, so you do not get both at once. Combinations are unaffected.&#x0a;OFF: the button sends the macro AND its normal input."/>
                                            <TextBlock Text="ON: a button used by a single-button macro stops sending its normal input, so you do not get both at once (combinations are unaffected). OFF: the button sends the macro AND its normal input." Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="ADVANCED SETTINGS">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="3. STICKS, TRIGGERS AND RUMBLE" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,14,0,2"/>
                                        <TextBlock Text="Some of these can be overridden by the preset chosen on the PRESETS tab." Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="Stick deadzones (0 - 32767)" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" Margin="0,14,0,2"/>
                                        <TextBlock Text="Calculated as a circle, not per axis. Min = the resting area (raise it if your character drifts on its own). Max = how far you must push to get 100% (lower it if diagonals will not run)." Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Left stick - Min" VerticalAlignment="Center" ToolTip="Resting area of the left stick (movement).&#x0a;Raise it if your character drifts on its own."/>
                                            <Slider Grid.Column="1" x:Name="sld_LS_DeadzoneMin" Minimum="0" Maximum="32767" Value="7000" SmallChange="100" LargeChange="1000" TickFrequency="1000" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,0" Tag="{Binding ElementName=val_LS_DeadzoneMin}" ToolTip="Resting area of the left stick (movement).&#x0a;Raise it if your character drifts on its own."/>
                                            <TextBlock Grid.Column="2" x:Name="val_LS_DeadzoneMin" Text="{Binding Value, ElementName=sld_LS_DeadzoneMin, StringFormat=F0, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Left stick - Max" VerticalAlignment="Center" ToolTip="How far you must push the left stick to get 100%.&#x0a;Lower it if diagonals will not run."/>
                                            <Slider Grid.Column="1" x:Name="sld_LS_DeadzoneMax" Minimum="0" Maximum="32767" Value="22000" SmallChange="100" LargeChange="1000" TickFrequency="1000" TickPlacement="BottomRight" Foreground="White" VerticalAlignment="Center" Margin="5,0" Tag="{Binding ElementName=val_LS_DeadzoneMax}" ToolTip="How far you must push the left stick to get 100%.&#x0a;Lower it if diagonals will not run."/>
                                            <TextBlock Grid.Column="2" x:Name="val_LS_DeadzoneMax" Text="{Binding Value, ElementName=sld_LS_DeadzoneMax, StringFormat=F0, ConverterCulture=en-US}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Right stick - Min" VerticalAlignment="Center" ToolTip="Resting area of the right stick (camera).&#x0a;Raise it if the camera drifts."/>
